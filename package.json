{
  "name": "robotics-trainer",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.21",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.80.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-bluetooth-classic": "^1.73.0-rc.17",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-wifi-reborn": "^4.13.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:mock": "EXPO_PUBLIC_MOCK_MODE=true expo start --go --clear",
    "android": "expo run:android",
    "android:mock": "EXPO_PUBLIC_MOCK_MODE=true expo run:android",
    "prebuild": "expo prebuild -p android --clean",
    "build:apk": "expo prebuild -p android && cd android && ./gradlew assembleRelease",
    "build:apk:mock": "EXPO_PUBLIC_MOCK_MODE=true npm run build:apk",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "postinstall": "patch-package",
    "lint": "expo lint"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-bluetooth-classic"
        ]
      }
    }
  }
}
